# ============================================
# Postgres
# ============================================
POSTGRES_USER=buyers
POSTGRES_PASSWORD=troca-por-uma-password-forte
POSTGRES_DB=buyers_crm

# ============================================
# Backend
# ============================================
ENV=prod
LOG_LEVEL=INFO

# ============================================
# JWT — gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================
JWT_SECRET=troca-por-um-segredo-forte
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Fotos
# ============================================
IDEALISTA_DOWNLOAD_CONCURRENCY=4
